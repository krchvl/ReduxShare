# ReduxShare — build-time environment template.
# Copy to .env and fill in what you need; .env is never committed.
# VITE_* values are inlined into the bundle at build time — rebuild after any change.

# Backend provider: pocketbase (default) or firebase.
# VITE_DATA_PROVIDER=pocketbase

# PocketBase instance URL (no trailing slash).
VITE_POCKETBASE_URL=https://pb.example.com

# Server label shown in the extension settings.
# VITE_POCKETBASE_LABEL=Primary [DE #1]

# Firebase project values (Project settings → General → Your apps).
# The Firebase API key is public — it ships inside the bundle.
# VITE_FIREBASE_API_KEY=AIzaSy...
# VITE_FIREBASE_PROJECT_ID=reduxshare-xxxxx
