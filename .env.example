# Backend provider: pocketbase (default) or firebase.
# VITE_DATA_PROVIDER=pocketbase

# --- PocketBase ---
# URL самохост-инстанса PocketBase (без слэша на конце).
# Продакшен на VPS:
VITE_POCKETBASE_URL=https://pb.example.com
# Подпись сервера в настройках расширения (селект "Сервер хранения"):
# VITE_POCKETBASE_LABEL=Основной [DE #1]
# Локальная проверка:
# VITE_POCKETBASE_URL=http://127.0.0.1:8090

# --- Firebase (используется при VITE_DATA_PROVIDER=firebase) ---
# Значения из консоли Firebase: Project settings → General → Your apps.
# API key Firebase публичный — это не секрет, он встраивается в бандл.
# VITE_FIREBASE_API_KEY=AIzaSy...
# VITE_FIREBASE_PROJECT_ID=reduxshare-xxxxx